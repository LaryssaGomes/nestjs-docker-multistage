# Copie este arquivo para ".env" e ajuste os valores antes de subir os containers.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

# --- MySQL (usado pelo container mysql para inicializar o banco) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mydatabase
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me-app

# --- Aplicação (usado pelo NestJS para conectar no banco) ---
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=change-me-app
DB_DATABASE=mydatabase

PORT=3000
